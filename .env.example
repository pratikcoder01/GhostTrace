# GhostTrace Forensic Intelligence Platform Configuration

# MongoDB Atlas Database Configuration
# Leave MONGODB_URI empty for offline/testing mode (uses in-memory mongomock).
# For production or Atlas, provide: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=ghosttrace
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_TIMEOUT_MS=5000

# Legacy Database (retained for data migration script migrate_sqlite_to_mongo.py)
DATABASE_URL=sqlite:///backend/data/ghosttrace.db

# TraceChain Proof-of-Work difficulty target (default: 2 leading zeros for fast local demonstration)
TRACECHAIN_DIFFICULTY=2

# Optional External Ethereum Adapters (Leave empty for safe deterministic offline demonstration)
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/api

# Alchemy Real-Time Ingestion (WebSocket & JSON-RPC)
ALCHEMY_API_KEY=
ALCHEMY_WS_URL=
ALCHEMY_HTTP_URL=
ETHEREUM_NETWORK=mainnet
ETHEREUM_CHAIN_ID=1

# Ingestion Engine & Observability Controls
LIVE_INGESTION_ENABLED=true
LIVE_SIMULATOR_ENABLED=true
BACKFILL_BLOCK_LIMIT=20
OSINT_POLL_INTERVAL_MINUTES=60
WS_HEARTBEAT_INTERVAL=15.0

# ML Active Decision Threshold (calibrated optimal cutoff: 0.42)
ML_ACTIVE_THRESHOLD=0.42

# Random Seed for Reproducibility
DEFAULT_RANDOM_STATE=42
